# ========== OpenClaw联邦总线公共配置 ==========
# 总线部署机器内网/公网IP
BUS_MQ_HOST=192.168.1.100
BUS_MQ_PORT=1883
# 联邦注册中心地址
REGISTRY_HTTP_URL=http://192.168.1.100:8500

# ========== 当前本机智能体身份（每台电脑自行修改） ==========
AGENT_ID=algorithm-dev-01
AGENT_ROLE=algorithm
AGENT_LOCAL_PORT=9800

# ========== 证书路径 ==========
CERT_ROOT_PATH=./config/cert
CLIENT_CERT=client.pem
CLIENT_KEY=client.key

# ========== 调试开关 ==========
DEBUG_MODE=true
PRINT_RAW_FED_MSG=true